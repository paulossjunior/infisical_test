# Host da instância Infisical (cloud US padrão; EU: https://eu.infisical.com; ou self-hosted)
INFISICAL_HOST=https://app.infisical.com

# Machine Identity com Universal Auth
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Projeto / ambiente / pasta alvo
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/

# Opcional: nome de um secret existente para testar leitura individual
INFISICAL_TEST_SECRET_NAME=
